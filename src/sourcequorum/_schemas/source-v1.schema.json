{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "source_id", "origin_group", "role", "collected_at", "records"],
  "properties": {
    "schema_version": {"const": "sourcequorum.source.v1"},
    "source_id": {"type": "string", "pattern": "^[a-z][a-z0-9._-]{0,127}$"},
    "origin_group": {"type": "string", "pattern": "^[a-z][a-z0-9._-]{0,127}$"},
    "role": {"enum": ["candidate", "crosscheck"]},
    "collected_at": {"type": "string", "format": "date-time"},
    "records": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "byte_count", "record_count"],
      "properties": {
        "path": {"const": "records.jsonl"},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "byte_count": {"type": "integer", "minimum": 0},
        "record_count": {"type": "integer", "minimum": 0}
      }
    }
  }
}
